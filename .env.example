# Rose — Family Personal Assistant
# Copy this to .env and fill in your values

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_GROUP_ID=your_group_chat_id_here

# Telegram user IDs (run /whoami in the group to get these)
TELEGRAM_USER_ID_LUKE=123456789
TELEGRAM_USER_ID_TONI=987654321

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google Calendar OAuth (run npm run auth to generate GOOGLE_TOKEN_JSON)
GOOGLE_CREDENTIALS_JSON={"installed":{"client_id":"...","client_secret":"...","redirect_uris":["urn:ietf:wg:oauth:2.0:oob"]}}
GOOGLE_TOKEN_JSON={"access_token":"...","refresh_token":"...","token_type":"Bearer","expiry_date":...}

# Optional
TIMEZONE=Europe/London
DB_PATH=./data/rose.db
